{
  "name": "diff-ex",
  "version": "0.1.0",
  "private": true,
  "description": "Offline desktop file comparison and merge workspace",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "vue-tsc --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "core:test": "cargo test -p diff-ex-core",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "diff": "^8.0.2",
    "jsonc-parser": "^3.3.1",
    "lucide-vue-next": "^0.468.0",
    "monaco-editor": "^0.55.1",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "playwright": "^1.65.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.5"
  }
}
